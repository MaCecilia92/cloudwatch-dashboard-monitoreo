// ============================================================================
// VERSIÓN COMENTADA, solo para leer. CloudWatch NO acepta comentarios en JSON:
// para crear el dashboard se usa Servidor-Web-Monitoreo-Dashboard.json.
// Referencia del formato: https://docs.aws.amazon.com/AmazonCloudWatch/latest/APIReference/CloudWatch-Dashboard-Body-Structure.html
// ============================================================================
{
  // 'widgets' es la única clave obligatoria: la lista de paneles del dashboard.
  // La grilla tiene 24 columnas de ancho: 'x' y 'y' ubican el widget, 'width' y 'height' lo dimensionan.
  "widgets": [
    // Widget 1 · TEXTO (markdown): identifica la instancia y enlaza al README.
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 3,
      "properties": {
        "markdown": "## Servidor web · monitoreo en tiempo real\nInstancia **i-REEMPLAZAR_POR_TU_INSTANCIA** (t3.micro) en la subred pública de la VPC del Módulo 6. Métricas estándar de EC2 cada **5 minutos** (monitoreo básico, sin costo). [Qué significa cada gráfico](https://github.com/MaCecilia92/cloudwatch-dashboard-monitoreo#qué-muestra-cada-widget)"
      }
    },
    // Widget 2 · CPU (línea). 'stat: Average' = promedio de cada período de 5 min.
      // La 2.ª métrica "..." repite la anterior (misma métrica e instancia) con otra estadística (Maximum).
      // 'annotations.horizontal' dibuja las líneas de referencia: 60 % (Auto Scaling) y 10 % (línea base t3).
    {
      "type": "metric",
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 7,
      "properties": {
        "title": "CPU del servidor web (%) · CPUUtilization",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Average",
        "period": 300,
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "i-REEMPLAZAR_POR_TU_INSTANCIA",
            {
              "label": "CPU promedio (%)",
              "color": "#ff7f0e"
            }
          ],
          [
            "...",
            {
              "stat": "Maximum",
              "label": "CPU máxima (%)",
              "color": "#d62728"
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100,
            "label": "Porcentaje",
            "showUnits": false
          }
        },
        "annotations": {
          "horizontal": [
            {
              "label": "Umbral de Auto Scaling (60 %)",
              "value": 60,
              "color": "#d62728"
            },
            {
              "label": "Línea base t3.micro (10 %)",
              "value": 10,
              "color": "#2ca02c",
              "fill": "below"
            }
          ]
        }
      }
    },
    // Widget 3 · RED (área apilada, 'stacked: true'). 'stat: Sum' = bytes totales del período.
      // "." en una posición significa "igual que en la fila anterior" (namespace, dimensión, instancia).
    {
      "type": "metric",
      "x": 12,
      "y": 3,
      "width": 12,
      "height": 7,
      "properties": {
        "title": "Tráfico de red (bytes cada 5 min) · NetworkIn / NetworkOut",
        "view": "timeSeries",
        "stacked": true,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            "AWS/EC2",
            "NetworkIn",
            "InstanceId",
            "i-REEMPLAZAR_POR_TU_INSTANCIA",
            {
              "label": "Entrada: lo que recibe el servidor",
              "color": "#1f77b4"
            }
          ],
          [
            ".",
            "NetworkOut",
            ".",
            ".",
            {
              "label": "Salida: lo que envía (páginas, archivos)",
              "color": "#9467bd"
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Bytes",
            "showUnits": false
          }
        }
      }
    },
    // Widget 4 · CRÉDITOS de CPU (instancias con ráfagas t2/t3/t4g).
    {
      "type": "metric",
      "x": 0,
      "y": 10,
      "width": 8,
      "height": 5,
      "properties": {
        "title": "Créditos de CPU disponibles · CPUCreditBalance",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Average",
        "period": 300,
        "metrics": [
          [
            "AWS/EC2",
            "CPUCreditBalance",
            "InstanceId",
            "i-REEMPLAZAR_POR_TU_INSTANCIA",
            {
              "label": "Créditos acumulados",
              "color": "#2ca02c"
            }
          ],
          [
            ".",
            "CPUCreditUsage",
            ".",
            ".",
            {
              "label": "Créditos usados en el período",
              "color": "#ff7f0e"
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Créditos",
            "showUnits": false
          }
        }
      }
    },
    // Widget 5 · CHEQUEOS DE ESTADO como número ('view: singleValue'). 'Maximum' = si hubo al menos una falla en el período, muestra 1.
    {
      "type": "metric",
      "x": 8,
      "y": 10,
      "width": 8,
      "height": 5,
      "properties": {
        "title": "Chequeos de estado (0 = OK, 1 = falla)",
        "view": "singleValue",
        "region": "us-east-1",
        "stat": "Maximum",
        "period": 300,
        "metrics": [
          [
            "AWS/EC2",
            "StatusCheckFailed_System",
            "InstanceId",
            "i-REEMPLAZAR_POR_TU_INSTANCIA",
            {
              "label": "Sistema (hardware de AWS)"
            }
          ],
          [
            ".",
            "StatusCheckFailed_Instance",
            ".",
            ".",
            {
              "label": "Instancia (sistema operativo)"
            }
          ]
        ]
      }
    },
    // Widget 6 · PAQUETES de red: cantidad, no tamaño.
    {
      "type": "metric",
      "x": 16,
      "y": 10,
      "width": 8,
      "height": 5,
      "properties": {
        "title": "Paquetes de red por período",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            "AWS/EC2",
            "NetworkPacketsIn",
            "InstanceId",
            "i-REEMPLAZAR_POR_TU_INSTANCIA",
            {
              "label": "Paquetes que entran"
            }
          ],
          [
            ".",
            "NetworkPacketsOut",
            ".",
            ".",
            {
              "label": "Paquetes que salen"
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Paquetes",
            "showUnits": false
          }
        }
      }
    },
    // Widget 7 · ALARMA ('type: alarm'): muestra si 'servidor-web-cpu-alta' está en OK, ALARM o INSUFFICIENT_DATA.
    {
      "type": "alarm",
      "x": 0,
      "y": 15,
      "width": 24,
      "height": 2,
      "properties": {
        "title": "Estado de la alarma: CPU mayor a 60 % durante 10 minutos",
        "alarms": [
          "arn:aws:cloudwatch:us-east-1:REEMPLAZAR_ID_CUENTA:alarm:servidor-web-cpu-alta"
        ]
      }
    }
  ]
}
